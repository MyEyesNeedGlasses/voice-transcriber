# Whisper model: tiny, base, small, medium, large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Speaker diarization (off by default). Requires a Hugging Face token with
# access to the pyannote models.
ENABLE_DIARIZATION=true
# Storage / limits
DB_PATH=data/transcriptions.db
MAX_UPLOAD_MB=500
